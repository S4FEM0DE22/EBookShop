# Local demo works without any external account: npm run dev
# For Vercel production, set SUPABASE_URL, SUPABASE_SECRET_KEY and DOWNLOAD_SECRET.
# RESEND_API_KEY and EMAIL_FROM enable E-book email delivery; PUBLIC_SITE_URL is optional.
# Test sender: SAFE MODE SHOP <onboarding@resend.dev> (only to your Resend account email).
# For customers, verify your own domain and use SAFE MODE SHOP <books@yourdomain.com>.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=Demo E-book <books@YOUR_VERIFIED_DOMAIN>
DOWNLOAD_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_SITE_URL=https://YOUR_PROJECT.vercel.app
# Generate a unique random password with at least 20 characters. Server-side only.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
